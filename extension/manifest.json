{
  "manifest_version": 3,
  "name": "Steal to AI",
  "version": "0.1.13",
  "description": "Pick a web element and copy clean HTML/CSS for AI or direct project use.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Steal to AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
