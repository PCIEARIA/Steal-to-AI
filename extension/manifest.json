{
  "manifest_version": 3,
  "name": "Steal to AI",
  "version": "0.1.17",
  "description": "Pick a web element and copy clean HTML/CSS for AI or direct project use.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Steal to AI",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
